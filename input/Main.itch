var alphabet
list test


define len(variable: var) {
    return operator_length(variable)
}


define main() {
    alphabet = "abcdefghijklmnopqrstuvwxyz"

    looks_sayforsecs(len(alphabet), 2)

    for i in alphabet {
        looks_say(i)
        control_wait(0.1)
    }
}


event event_whenflagclicked() {
    if "a" in test {
        looks_say("oh noes!")
    }
    main()
}

